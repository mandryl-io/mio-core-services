[Unit]
Description=Mio conversation
# The local console uses Deepgram STT, OpenAI TTS, Baseten GLM 5.3, and
# LiveKit's hosted turn detector, so wait for connectivity rather than GPIO/UART.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mio
WorkingDirectory=/home/mio/mio-core-services-waveshare
EnvironmentFile=/home/mio/mio-core-services-waveshare/.env
# OS/root-level secrets such as BASETEN_API_KEY. Loaded after .env so the
# host value wins. systemd does not read /etc/environment on its own.
EnvironmentFile=-/etc/default/mio
Environment=ALSA_CONFIG_DIR=/usr/share/alsa
Environment=ALSA_CONFIG_PATH=/usr/share/alsa/alsa.conf
Environment=PA_ALSA_PLUGHW=1
Environment=MIO_SYSTEM_PROMPT_PATH=prompts/default.md
Environment=MIO_FIRST_USE=true
# The current LiveKit CLI drives local console audio without the deprecated
# Python run_app wrapper.
ExecStart=/usr/bin/env lk agent console --input-device "USB Audio Device" --output-device "UACDemoV1.0" mio_core_services/conversation.py
StandardInput=tty
TTYPath=/dev/tty8
TTYReset=yes
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
