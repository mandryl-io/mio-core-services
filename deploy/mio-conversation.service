[Unit]
Description=Mio conversation
# Wait for WiFi bootstrap (and then a real network) before talking to
# Deepgram / OpenAI / Baseten / LiveKit. GPIO and the servo UART are unrelated.
After=mio-wifi.service network-online.target
Wants=mio-wifi.service network-online.target

[Service]
Type=simple
User=mio
WorkingDirectory=/home/mio/mio-core-services-waveshare
EnvironmentFile=/home/mio/mio-core-services-waveshare/.env
# OS/root-level secrets such as BASETEN_API_KEY. Loaded after .env so the
# host value wins. systemd does not read /etc/environment on its own.
EnvironmentFile=-/etc/default/mio
Environment=ALSA_CONFIG_DIR=/usr/share/alsa
Environment=ALSA_CONFIG_PATH=/usr/share/alsa/alsa.conf
Environment=PA_ALSA_PLUGHW=1
Environment=MIO_SYSTEM_PROMPT_PATH=prompts/default.md
# MIO_FIRST_USE is set in /etc/default/mio by deploy/apply-and-reboot.sh.
# Device names and ALSA env live in the Makefile target.
ExecStart=/usr/bin/make run-conversation-service
StandardInput=tty
TTYPath=/dev/tty8
TTYReset=yes
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
