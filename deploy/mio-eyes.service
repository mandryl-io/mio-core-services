[Unit]
Description=Mio idle eye blink
# After WiFi bootstrap so setup can fade the eyes on GPIO23/24, then release
# the pins before idle blink takes them.
After=mio-wifi.service
Wants=mio-wifi.service

[Service]
Type=simple
User=mio
WorkingDirectory=/home/mio/mio-core-services-waveshare
# ledenv sees system gpiozero; the repo .venv does not.
ExecStart=/home/mio/ledenv/bin/python -m mio_core_services.lighting.idle_blink
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
