[Unit]
Description=Mio head motion
# Wait for WiFi bootstrap so the setup hotspot (and its eye fade) finish
# before the head starts moving. Then wait for the servo UART.
After=mio-wifi.service dev-ttyAMA0.device
Wants=mio-wifi.service dev-ttyAMA0.device

[Service]
Type=simple
User=mio
WorkingDirectory=/home/mio/mio-core-services-waveshare
# The venv interpreter directly, not uv: no dependency resolution, no network,
# nothing to fail before the head moves.
ExecStart=/home/mio/mio-core-services-waveshare/.venv/bin/python -m mio_core_services.firmware.runtime.idle_motion
# idle_motion centres and releases torque on SIGTERM; give it time to finish.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
